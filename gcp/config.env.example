# Copy to config.env and edit. Used by create-vm.sh / fetch-results.ps1
# Do not commit config.env if it contains secrets.

PROJECT_ID=your-gcp-project-id
ZONE=us-central1-a
REGION=us-central1

# VM
VM_NAME=tp-mcts-64cpu
MACHINE_TYPE=n2-highcpu-64
# n2-highcpu-64 = 64 vCPU, 64 GB RAM (good CPU-only default)
DISK_SIZE_GB=100

# Repo (public clone; for private repos use SSH deploy key — see README)
REPO_URL=https://github.com/eliezerRevach/tp_mcts.git
REPO_BRANCH=
GCE_REPO_DIR=/opt/tp_mcts
